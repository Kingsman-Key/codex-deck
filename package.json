{
  "name": "codex-deck",
  "version": "0.3.5",
  "private": true,
  "description": "Launch and focus multiple isolated Codex desktop profiles from one dashboard.",
  "main": "dist/electron/electron/main.js",
  "author": "Codex Deck contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kingsman-Key/codex-deck.git"
  },
  "bugs": {
    "url": "https://github.com/Kingsman-Key/codex-deck/issues"
  },
  "homepage": "https://github.com/Kingsman-Key/codex-deck#readme",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist/electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run typecheck && npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.codexdeck.launcher",
    "productName": "Codex Deck",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "buildResources",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "buildResources/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "icon": "buildResources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "buildResources/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
